-- Test specs, the test runner and dev tools run outside the game.
files["tests/"] = {
	std = "luajit",
	globals = { "describe", "it", "before_each", "after_each" },
	read_globals = { "jit" },
}
files["tools/"] = { std = "luajit" }
files["types/"] = { ignore = { "1" } }
